# ============================================================================
# EasyRent24 local settings — read by docker compose (Start EasyRent.bat).
# This file is ignored by git. Never commit it or paste its secrets anywhere.
# ============================================================================

# -- Payments ----------------------------------------------------------------
# demo    = EasyRent Pay, the built-in demo checkout. No money moves.
#           Card 4242 4242 4242 4242 (any future expiry, any CVV) approves;
#           every other card is declined.
# payfast = real PayFast (production). Switch back by setting payfast below
#           and filling in the PayFast block that follows.
# PAYMENT_PROVIDER=demo
PAYMENT_PROVIDER=payfast

# ── PayFast: your merchant account (32159585) ───────────────────────────────
# PayFast dashboard → Settings → Integration. Copy the Merchant Key and set a
# Passphrase there (the same passphrase must be entered below).
# Until MERCHANT_KEY is filled in, payments show "Payments are not configured yet".
PAYFAST_MODE=live
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Public address of the app. Live PayFast must reach <APP_URL>/api/payments/payfast/notify,
# so localhost only works for browsing — "Start EasyRent (public).bat" sets this for you.
APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
